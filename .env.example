# ==============================================================================
# Lakehouse Crypto Environment Variables Template
# Copy this file to .env and configure your credentials
# ==============================================================================

COMPOSE_PROJECT_NAME=project_hybrid_lakehouse_crypto

# PostgreSQL (Airflow Metadata DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_secure_password
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_secure_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Iceberg REST Catalog
ICEBERG_REST_PORT=8181
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=minio_secure_password
AWS_REGION=us-east-1

# Apache Spark
SPARK_UI_PORT=8080
SPARK_THRIFT_PORT=10000
JUPYTER_PORT=8888

# Apache Airflow
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_password
AIRFLOW_ADMIN_EMAIL=admin@lakehouse.local
# Generate fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key_here

# Alpaca Crypto Market Data API (Optional - for live hourly incremental bars from Alpaca)
# Free account at https://alpaca.markets/ (Note: Binance REST API is public and needs NO key!)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

